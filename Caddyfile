{
	email admin@gross.dev

	# Use Let's Encrypt exclusively.
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	#include the configured hostname in HTTP metrics
	metrics {
		per_host
	}
}

requesthole.com {
	reverse_proxy requesthole-nginx:80 {
		# Never trust an incoming client-supplied forwarding chain.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Support Server-Sent Events and streaming responses.
		flush_interval -1
	}
}

www.requesthole.com {
	redir https://requesthole.com{uri} permanent
}

gross.dev {
	reverse_proxy grossdev:80
}

www.gross.dev {
	redir https://gross.dev{uri} permanent
}

health.gross.dev {
	respond "OK" 200
}

umami.is-very.online {
	reverse_proxy umami:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# metrics are reachable from the host and the shared Docker network.
http://172.30.0.2:9180 {
	bind 172.30.0.2
	metrics /metrics
}
