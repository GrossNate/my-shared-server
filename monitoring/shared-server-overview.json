            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "{job=\"integrations/docker\", instance=\"vm2323\"}\n| json message=\"msg\", status=\"res.statusCode\", duration_ms=\"responseTime\", request_id=\"reqId\", method=\"req.method\", path=\"req.url\"\n| line_format `{{if .message}}{{.message}}{{if .method}} | {{.method}} {{.path}}{{end}}{{if .status}} | status={{.status}}{{end}}{{if .duration_ms}} | duration={{.duration_ms}}ms{{end}}{{if .request_id}} | request={{.request_id}}{{end}}{{else}}{{ __line__ }}{{end}}`\n| drop message, status, duration_ms, request_id, method, path, __error__, __error_details__",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
