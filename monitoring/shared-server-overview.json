        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Latest HTTPS check results",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "min by (job) (\n  last_over_time(\n    probe_success{\n      job=~\"grossdev-https|requesthole-https|requesthole-backend-https|grossnate-server-caddy-https\"\n    }[30m]\n  )\n)",
